# ---------------------------------------------------------------------------
# inkaPos · variables de entorno
# Copia este archivo a .env. Los valores comentados como "producción" son los
# que deben ir en el servidor real.
# ---------------------------------------------------------------------------

APP_NAME=inkaPos
APP_ENV=local                 # producción: production
APP_KEY=                      # php artisan key:generate (NUNCA rotarla sin APP_PREVIOUS_KEYS: cifra claves SOL y certificados)
APP_DEBUG=true                # producción: false
APP_URL=http://localhost      # producción: https://tudominio.pe
# Tienda en línea: cada empresa publica su catálogo en {slug}.TIENDA_DOMINIO. Si se deja vacío se usa el
# dominio de APP_URL sin su primer nombre (pos.inkanet.pro -> inkanet.pro). Requiere DNS comodín (*.dominio)
# apuntando al servidor y un bloque de Nginx para ese comodín (ver deploy/nginx-inkapos.conf).
# TIENDA_DOMINIO=inkanet.pro
# TIENDA_RESERVADOS=otrositio,otro     # subdominios ya usados por otros sitios: nadie puede elegirlos

# Dominios desde los que se acepta la app (evita envenenar enlaces de correo). Por defecto el host de APP_URL.
TRUSTED_HOSTS=
# IPs del balanceador/proxy, o "*" si nginx/Cloudflare está delante en el mismo servidor.
TRUSTED_PROXIES=
# Fuerza https en los enlaces generados (por defecto sí en producción).
# FORCE_HTTPS=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Contacto que se muestra en Suscripción para activar planes (WhatsApp sin "+", p. ej. 51987654321)
APP_SOPORTE_WHATSAPP=51977425905
APP_SOPORTE_EMAIL=calidad@inkanet.pro

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # un archivo por día; LOG_DAILY_DAYS controla la retención
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # producción: warning

# PostgreSQL (el esquema está en database/schema/pgsql-schema.sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pos_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file           # producción: database o redis (permite cerrar sesiones ajenas)
SESSION_LIFETIME=480          # minutos: un turno de caja completo
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # producción: true (solo https)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local         # XML/CDR de SUNAT en storage/app/private/sunat: respaldar
QUEUE_CONNECTION=database     # tablas jobs/failed_jobs (database/sql/001); worker: php artisan queue:work
CACHE_STORE=file              # producción: redis recomendado (locks compartidos entre procesos)

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional (recuperación de contraseña, comprobantes al cliente)
MAIL_MAILER=smtp
MAIL_SCHEME=null              # producción: tls
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=calidad@inkanet.pro
MAIL_FROM_NAME="${APP_NAME}"

# Consulta de RUC/DNI (Decolecta)
API_TOKEN_SUNAT=

# wkhtmltopdf para tickets, A4 y reportes
# Windows: WKHTML_PDF_BINARY="C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe"
# Linux:   WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf

VITE_APP_NAME="${APP_NAME}"

# Respaldo fuera del servidor (Cloudflare R2 u otro compatible con S3). Vacío = no se respalda en la nube.
# Lo corre el scheduler cada noche (php artisan respaldo:nube). El .env NO se sube: guarda APP_KEY aparte.
RESPALDO_BUCKET=
RESPALDO_ENDPOINT=             # https://<account-id>.r2.cloudflarestorage.com
RESPALDO_ACCESS_KEY_ID=
RESPALDO_SECRET_ACCESS_KEY=
RESPALDO_REGION=auto

# Fotos de productos en la nube (bucket PUBLICO, distinto al de respaldos). Vacío = se guardan en el servidor.
# Usa las mismas credenciales RESPALDO_* salvo que definas IMAGENES_ACCESS_KEY_ID / IMAGENES_SECRET_ACCESS_KEY.
# Tras configurarlo: php artisan productos:imagenes-a-nube  (sube las fotos que ya existen).
IMAGENES_BUCKET=
IMAGENES_URL=                  # dirección pública del bucket, p. ej. https://img.inkanet.pro
