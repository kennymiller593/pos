# /etc/supervisor/conf.d/pos-app.conf
# sudo supervisorctl reread && sudo supervisorctl update && sudo supervisorctl start pos-app-worker:*

[program:pos-app-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/pos-app/artisan queue:work --sleep=3 --tries=3 --max-time=3600
directory=/var/www/pos-app
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/pos-app/storage/logs/worker.log
stopwaitsecs=3600
